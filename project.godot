; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Archive"
config/description="归档计划 / Project Archive：汇聚生灵与余烬，以静默融合自然，以永恒记录与重塑的地块经营游戏。"
run/main_scene="res://scenes/title.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="NeoCurrency"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Settings="*res://scripts/core/settings.gd"
Data="*res://scripts/core/data_catalog.gd"
Land="*res://scripts/core/land_system.gd"
Sim="*res://scripts/core/simulation.gd"
Art="*res://scripts/core/art_cache.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=960
window/size/window_width_override=1440
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.11, 0.1, 0.12, 1)
